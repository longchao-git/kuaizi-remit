# Backend root URL. A real device cannot reach the computer through 127.0.0.1.
VITE_APP_BASE_URL=https://api.kzremit.com/api/
# 仅开发模式可开启本地账号登录入口。
VITE_REMIT_LOCAL_LOGIN=false
VITE_REMIT_LOCAL_SMS_LOGIN=true
# 本地短信测试环境自动回填验证码；设为 false 关闭。
VITE_REMIT_SMS_AUTOFILL=true
VITE_REMIT_PUSH_ENABLED=false
# 仅原型预览包显式开启，正式包保持关闭。
VITE_REMIT_DEMO=false
VITE_REVERB_URL=wss://api.kzremit.com
VITE_REVERB_APP_KEY=
