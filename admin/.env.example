# 后台直接请求独立API域名，业务路径不再追加/api。
VITE_API_BASE=https://api.kzremit.com/

# 仅供本地开发代理使用，请按后端实际地址修改。
VITE_PROXY_TARGET=http://127.0.0.1:8688
VITE_REVERB_URL=wss://api.kzremit.com
VITE_REVERB_APP_KEY=

# TinyMCE 8 自托管许可标识，使用富文本前必须按项目实际许可填写。
# 仅当项目满足 GPL 要求时填写 gpl；商业许可项目填写 TinyMCE 提供的 T8LK:...。
VITE_TINYMCE_LICENSE_KEY=
