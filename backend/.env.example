APP_NAME="筷子闪汇"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8688

# 仅本地联调。留空时关闭测试账号登录和测试汇率。
REMIT_LOCAL_LOGIN_EMAIL=
REMIT_CHANNEL=yaband
# local 渠道仅允许本地 SQLite。pending、paid、delivered、failed、refunding、refunded。
REMIT_LOCAL_SCENARIO=pending
# 独立的 32 字节随机值，填入 base64 文本。迁移旧手机号和手机号登录前必须配置。
REMIT_PHONE_LOOKUP_KEY=
# 新 App 真机通过后启用，旧包的高风险请求会被拒绝。
REMIT_REQUIRE_DEVICE_SIGNATURES=false
YABAND_REMIT_ENVIRONMENT=sandbox
YABAND_REMIT_BASE_URL=
YABAND_REMIT_MID=
YABAND_REMIT_PASSWORD=
YABAND_REMIT_SECRET_KEY=
# 只在核实通知算法、商户及回调入口后显式开启；请求签名不自动启用通知。
YABAND_REMIT_CALLBACK_VERIFICATION_ENABLED=false
# 雅本正式回调应要求供应商确认的来源 IP/CIDR。逗号分隔，留空仅保留沙箱验签兼容。
YABAND_REMIT_CALLBACK_IP_REQUIRED=false
YABAND_REMIT_CALLBACK_SOURCE_IPS=
YABAND_REMIT_KYC_REDIRECT_URL=
YABAND_REMIT_KYC_NOTIFY_URL=
YABAND_REMIT_EXTERNAL_UID_PREFIX=
# 雅本 EUR→CNY 参考汇率，只用于试算，不开启正式付款。
YABAND_REMIT_REFERENCE_RATE_ENABLED=false
# 漏通知查单补偿默认关闭；部署迁移并完成查询联调后再开启。
YABAND_REMIT_ORDER_SYNC_ENABLED=false
YABAND_REMIT_ORDER_SYNC_INTERVAL_SECONDS=300
YABAND_REMIT_ORDER_SYNC_BATCH_SIZE=10
REMIT_PLATFORM_ADMIN_EMAILS=
REMIT_LOCAL_RATE_TEN_THOUSANDTHS=

APP_LOCALE=en
REMIT_LOCAL_SMS_LOGIN=false
# 独立沙箱测试登录：仅指定测试手机号，私有配置注入测试码，默认关闭。
REMIT_TEST_SMS_LOGIN_ENABLED=false
REMIT_TEST_SMS_LOGIN_MOBILE=
REMIT_TEST_SMS_LOGIN_CODE=
REMIT_SMS_CHANNEL=log
REMIT_SMS_TEST_AUTOFILL=false
REMIT_PUSH_ENABLED=false
REMIT_PUSH_BRIDGE_URL=
REMIT_PUSH_BRIDGE_SECRET=
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
