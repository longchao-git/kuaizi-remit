APP_NAME="筷子闪汇"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8688

# 仅本地联调。留空时关闭测试账号登录和测试汇率。
REMIT_LOCAL_LOGIN_EMAIL=
YABAND_REMIT_BASE_URL=
YABAND_REMIT_MID=
YABAND_REMIT_PASSWORD=
YABAND_REMIT_SECRET_KEY=
YABAND_REMIT_KYC_REDIRECT_URL=
YABAND_REMIT_KYC_NOTIFY_URL=
YABAND_REMIT_EXTERNAL_UID_PREFIX=
REMIT_PLATFORM_ADMIN_EMAILS=
REMIT_LOCAL_RATE_TEN_THOUSANDTHS=

APP_LOCALE=en
REMIT_LOCAL_SMS_LOGIN=false
REMIT_SMS_CHANNEL=log
REMIT_SMS_TEST_AUTOFILL=false
REMIT_PUSH_ENABLED=false
REMIT_PUSH_BRIDGE_URL=
REMIT_PUSH_BRIDGE_SECRET=
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080
REVERB_ALLOWED_ORIGINS=127.0.0.1,localhost
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
